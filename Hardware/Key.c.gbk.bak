#include "gpio.h"
uint8_t Key_Num;

//对于任务调度来说，用队列获取键值，这个函数不用了，对于任务里面的一些操作比如恐龙跳跃，获取键值还是用这个函数
uint8_t Key_GetNum(void)
{
	uint8_t Temp;
	if(Key_Num)
	{
		Temp=Key_Num;
		Key_Num=0;
		return Temp;
	}
	else
	{
		return 0;
	}
}

int press_time;
void Key3_Tick(void)
{
	if(HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_4) == GPIO_PIN_RESET)
	{
		press_time++;
	}
	
	if(HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_4) == GPIO_PIN_SET)
	{
		press_time=0;
	}
};

uint8_t Key_GetState(void)
{
	
	if (HAL_GPIO_ReadPin(GPIOB, GPIO_PIN_1) == GPIO_PIN_RESET)
	{
		return 1;
	}
	else if (HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_6) == GPIO_PIN_RESET)
	{
		return 2;
	}
	else if (HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_4) == GPIO_PIN_RESET)
	{
		if(press_time > 1000)
		{
			return 4; // 长按
		}
		else
		{
			return 3; // 短按
		}
	}
	else
	{
		return 0;
	}
	
}

void Key_Tick(void)//每20ms检测1次，定时器周期是1ms
{
	static uint8_t Count;
	static uint8_t CurrentState,PreState;
	Count++;
	if(Count>=20)
	{
		Count=0;
		PreState=CurrentState;
		CurrentState=Key_GetState();
		if(PreState!=0&&CurrentState==0)
		{
			Key_Num=PreState;
		}
	}
}
